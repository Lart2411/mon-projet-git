<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <connectionStrings>
    <!-- Adapter le serveur/la base de données à l'environnement cible -->
    <add name="SupplierDb"
         connectionString="Data Source=SERVEUR_SQL;Initial Catalog=SupplierPmPgDb;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
